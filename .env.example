# For running the agent on your own computer. Copy to .env and fill in. Never commit .env.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Leave MEDIA_BASE_URL empty: in GitHub Actions the agent builds it from the exact commit, so an edited image
# can never be served from a stale cache. Only set it if your media lives somewhere else (must be public).
MEDIA_BASE_URL=
TIMEZONE=Europe/Budapest
# Optional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# SEO (optional): the whole service-account JSON on one line, and the Search Console property
GSC_SERVICE_ACCOUNT_JSON=
GSC_PROPERTY=sc-domain:bloommodels.hu
PAGESPEED_API_KEY=
# Marketing agent: stop a weekly run once Claude has cost this much (USD); 0 disables web research
MARKETING_MAX_COST_USD=2
MARKETING_RESEARCH=1
