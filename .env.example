# For running the agent on your own computer. Copy to .env and fill in. Never commit .env.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Leave MEDIA_BASE_URL empty: in GitHub Actions the agent builds it from the exact commit, so an edited image
# can never be served from a stale cache. Only set it if your media lives somewhere else (must be public).
MEDIA_BASE_URL=
TIMEZONE=Europe/Budapest
# Optional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
